h ``&quot;... is no longer here&quot;``\nPERSONAL_EXPERIENCE node). A future refactor that moves the\npreservation call below the mutation would silently lose the\nhearsay; this test catches that.\n</code></pre>\n","environment":"default","setup":[{"id":"3828f4cc54c902f37a59fe77e552f88b","type":"before","name":"_install_log_scrubber","status":"passed","steps":[],"duration":0},{"id":"bfdcb654098bdb822876deb4867d690f","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0}],"teardown":[{"id":"a383a39f1e25245ba092c0655896969d","type":"after","name":"_install_log_scrubber::0","status":"passed","steps":[],"duration":0}],"history":[],"retries":[],"breadcrumbs":[["tests","test_effect_applier_memory_preservation"]],"retry":false,"titlePath":["tests","test_effect_applier_memory_preservation.py"],"retriesCount":0,"attachments":[],"order":1121,"categories":[]}