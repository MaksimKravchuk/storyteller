cene, the second witness's later departure must still fan a\nfresh hearsay copy out, attributed to *that* witness as\n``told_by``. Locking this catches a regression where the\npropagation tag was stored on the node and the second departure\nbecame a silent no-op.\n</code></pre>\n","environment":"default","setup":[{"id":"5647704ad082494049abc13e0572eca7","type":"before","name":"_install_log_scrubber","status":"passed","steps":[],"duration":0},{"id":"100d1441b3d6b906c53aaa7f1a8abd3f","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"3852d86a8201150f1452a98cf3d2ca75","type":"after","name":"_install_log_scrubber::0","status":"passed","steps":[],"duration":0}],"history":[],"retries":[],"breadcrumbs":[["tests","test_memory_preservation"]],"retry":false,"titlePath":["tests","test_memory_preservation.py"],"retriesCount":0,"attachments":[],"order":1584,"categories":[]}