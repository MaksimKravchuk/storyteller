h ``&quot;... is no longer here&quot;``\nPERSONAL_EXPERIENCE node). A future refactor that moves the\npreservation call below the mutation would silently lose the\nhearsay; this test catches that.\n</code></pre>\n","environment":"default","setup":[{"id":"f37b295e11aebc26aa3f47c9b8559e3d","type":"before","name":"_install_log_scrubber","status":"passed","steps":[],"duration":0},{"id":"b50da2f5db256cfbfbfc473f110ff0b5","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0}],"teardown":[{"id":"6d0fc708d185980d502e45b60a12c925","type":"after","name":"_install_log_scrubber::0","status":"passed","steps":[],"duration":0}],"history":[],"retries":[],"breadcrumbs":[["tests","test_effect_applier_memory_preservation"]],"retry":false,"titlePath":["tests","test_effect_applier_memory_preservation.py"],"retriesCount":0,"attachments":[],"order":1114,"categories":[]}