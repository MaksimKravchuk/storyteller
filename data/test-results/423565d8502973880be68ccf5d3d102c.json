pe":"attachment"}],"error":{},"testCase":{"id":"43ededb32c2f835ad7d0c95db27a5d08","externalId":"61b675e0c15f95ef180e3368fad542b0","name":"handle_dialogue gives every non-targeted scene NPC an overheard memory referencing the player's statement (KER-11)","fullName":"tests.test_director_dialogue_memory.TestDialogueHandlerLongTermMemory#test_handle_dialogue_broadcasts_cowitness_memory"},"descriptionHtml":"<p>Regression for KER-11.</p>\n<pre><code>    Before the co-witness broadcast, a player who confessed a crime\n    to NPC A while NPC B was standing right next to them would find\n    NPC B later had *no memory* of the confession — only NPC A was\n    in the dialogue work items, and ``_summarize_interactions`` only\n    iterated those. This test wires a two-NPC scene, runs a single\n    TALK turn aimed at NPC A, and checks that NPC B's personal\n    memories come back carrying the player's incriminating text\n    without the summariser having been called a second time for\n    the bystander.\n</code></pre>\n","environment":"default","setup":[{"id":"460eb10a766ee54b77c3f40370437b00","type":"before","name":"_install_log_scrubber","status":"passed","steps":[],"duration":0},{"id":"0f0211db4dbc51b8c61c387e00ee2f79","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":1},{"id":"0726c81e16e5a776cd21d3aa6697fe3d","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"223ef985c5b0b2c65ef006e6b119799d","type":"after","name":"_install_log_scrubber::0","status":"passed","steps":[],"duration":0},{"id":"aae6c5789dc06059027b9100e1a00098","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":0}],"history":[],"retries":[],"breadcrumbs":[["tests","test_director_dialogue_memory","TestDialogueHandlerLongTermMemory"]],"retry":false,"titlePath":["tests","test_director_dialogue_memory.py","TestDialogueHandlerLongTermMemory"],"retriesCount":0,"attachments":[{"link":{"id