pe":"attachment"}],"error":{},"testCase":{"id":"43ededb32c2f835ad7d0c95db27a5d08","externalId":"61b675e0c15f95ef180e3368fad542b0","name":"handle_dialogue gives every non-targeted scene NPC an overheard memory referencing the player's statement (KER-11)","fullName":"tests.test_director_dialogue_memory.TestDialogueHandlerLongTermMemory#test_handle_dialogue_broadcasts_cowitness_memory"},"descriptionHtml":"<p>Regression for KER-11.</p>\n<pre><code>    Before the co-witness broadcast, a player who confessed a crime\n    to NPC A while NPC B was standing right next to them would find\n    NPC B later had *no memory* of the confession — only NPC A was\n    in the dialogue work items, and ``_summarize_interactions`` only\n    iterated those. This test wires a two-NPC scene, runs a single\n    TALK turn aimed at NPC A, and checks that NPC B's personal\n    memories come back carrying the player's incriminating text\n    without the summariser having been called a second time for\n    the bystander.\n</code></pre>\n","environment":"default","setup":[{"id":"4d50ba4950b4a1a30c13acb97a92596b","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":0},{"id":"acd8013f2fa07cbc4b09e9c1dea9a5c2","type":"before","name":"_install_log_scrubber","status":"passed","steps":[],"duration":0},{"id":"2518e90eaefdab7860aa861e047361b4","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"58d2f137a816d47f0e942992052b5e70","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":0},{"id":"d93e07dcc53c818efe2bf8fd72a37f00","type":"after","name":"_install_log_scrubber::0","status":"passed","steps":[],"duration":0}],"history":[],"retries":[],"breadcrumbs":[["tests","test_director_dialogue_memory","TestDialogueHandlerLongTermMemory"]],"retry":false,"titlePath":["tests","test_director_dialogue_memory.py","TestDialogueHandlerLongTermMemory"],"retriesCount":0,"attachments":[{"link":{"us