# Storyteller — Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or export variables in your shell directly.

# ── API Keys ─────────────────────────────────────────────
# Set the key for whichever provider you use.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...

# ── Models per agent role ────────────────────────────────
# Provider is auto-detected from model name:
#   gpt-* / o1-* / o3-*    → openai
#   claude-*                → anthropic
#   deepseek-*              → deepseek (api.deepseek.com)
#   <vendor>/<model>        → openrouter (deepseek/, google/, x-ai/, ...)
DIRECTOR_MODEL=gpt-6-luna
AGENT_MODEL=gpt-6-luna
NARRATOR_MODEL=gpt-6-luna

# ── World-research search backend ────────────────────────
# The Data Miner grounds new settings by searching this backend.
#   wikipedia  → English Wikipedia (default, no config needed)
#   tavily     → Tavily hosted AI search (requires TAVILY_API_KEY)
#   searxng    → self-hosted SearXNG instance (requires SEARXNG_BASE_URL)
# Selection is fail-fast: a missing key/URL raises at engine startup.
# SEARCH_PROVIDER=wikipedia
# TAVILY_API_KEY=tvly-...
# SEARXNG_BASE_URL=http://localhost:8888

# ── Override provider detection ──────────────────────────
# Only needed if using a model name that doesn't start with
# "gpt-" or "claude-" (e.g. a custom/fine-tuned model).
# DEFAULT_PROVIDER=openai

# ── LLM parameters (optional) ───────────────────────────
# TEMPERATURE=0.7
# MAX_TOKENS=2048

# ── Story posters (ADR-0020) ────────────────────────────
# Every story gets a free typographic playbill in "My Stories".
# Painted illustrations are paid image-model calls (OpenAI key required),
# off by default, one per story, capped per player per rolling day.
# POSTER_IMAGES_ENABLED=false
# POSTER_IMAGE_MODEL=gpt-image-1-mini
# POSTER_IMAGE_QUALITY=medium
# POSTER_DAILY_IMAGE_QUOTA=3
