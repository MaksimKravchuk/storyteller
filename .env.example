# Storyteller — Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or export variables in your shell directly.

# ── API Keys ─────────────────────────────────────────────
# Set the key for whichever provider you use.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Models per agent role ────────────────────────────────
# Provider is auto-detected from model name:
#   gpt-* / o1-* / o3-*  → openai
#   claude-*              → anthropic
DIRECTOR_MODEL=gpt-5.4-mini
AGENT_MODEL=gpt-5.4-nano
NARRATOR_MODEL=gpt-5.4-mini

# ── Override provider detection ──────────────────────────
# Only needed if using a model name that doesn't start with
# "gpt-" or "claude-" (e.g. a custom/fine-tuned model).
# DEFAULT_PROVIDER=openai

# ── Telegram Bot ──────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── LLM parameters (optional) ───────────────────────────
# TEMPERATURE=0.7
# MAX_TOKENS=2048
